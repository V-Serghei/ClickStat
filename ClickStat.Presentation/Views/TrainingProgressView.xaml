<UserControl x:Class="ClickStat.Presentation.Views.TrainingProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ClickStat.Presentation.Services">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#7C3FD6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#AA70FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#8D55E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#6E32C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common.LoadingData]}"
                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Title]}"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Hint]}"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Start]}"
                            Command="{Binding OpenTypingTrainerCommand}"
                            Style="{StaticResource PrimaryActionButton}"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}"
                        BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.LanguageProgress]}"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding Languages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBackground}"
                                            BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,12,12"
                                            Width="230">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Language}" Foreground="#AA70FF" FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="{Binding Sessions, StringFormat=Sessions: {0}}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding BestWpm, StringFormat=Best WPM: {0}}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Text="{Binding AverageWpm, StringFormat=Average WPM: {0}}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Text="{Binding AverageAccuracy, StringFormat=Accuracy: {0}%}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Text="{Binding TotalErrors, StringFormat=Errors: {0}}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.NoData]}"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}"
                        BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="WPM development"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBackground}"
                                BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,18"
                                MinHeight="170">
                            <ItemsControl ItemsSource="{Binding ChartItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="34" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Wpm}" Foreground="#AA70FF" FontSize="10" HorizontalAlignment="Center"/>
                                            <Border Height="{Binding RelativeHeight}"
                                                    Background="#AA70FF"
                                                    CornerRadius="5,5,2,2"
                                                    Margin="0,4,0,5"/>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}"
                        BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.RecentSessions]}"
                                   Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Language]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Wpm]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Cpm]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Accuracy]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Errors]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Training.Date]}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBackground}"
                                            BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Language}" Foreground="#AA70FF" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Wpm}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Cpm}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Accuracy, StringFormat={}{0}%}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Errors}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding CompletedAt}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
