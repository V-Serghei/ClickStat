<UserControl x:Class="ClickStat.Presentation.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.Wpf"
             xmlns:presentation="clr-namespace:ClickStat.Presentation"
             xmlns:services="clr-namespace:ClickStat.Presentation.Services"
             Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}">

    <UserControl.Resources>
        <Style x:Key="HistoryButton" TargetType="Button">
            <Setter Property="Background" Value="#1B1B35"/>
            <Setter Property="Foreground" Value="#B5B0D5"/>
            <Setter Property="BorderBrush" Value="#38345C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#302650"/><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        <Trigger Property="Tag" Value="True"><Setter TargetName="Body" Property="Background" Value="#7046BB"/><Setter TargetName="Body" Property="BorderBrush" Value="#AA70FF"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Nav.Overview]}"
                       Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#151530" CornerRadius="8"
                        Padding="10,5" BorderBrush="#2A2A5A" BorderThickness="1"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BUILD" Foreground="#606080" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static presentation:AppVersion.Display}"
                                   Foreground="#AA70FF" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="8"
                        Padding="12,5" BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Visibility>
                        <Binding Path="LiveIndicatorVisible">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#50FF80"
                                 VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.9"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="LIVE" Foreground="#50FF80" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="10" Padding="18" Margin="0,0,12,0"
                    BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.TotalClicks]}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"/>
                    <TextBlock Text="{Binding TotalClicks, StringFormat='{}{0:N0}'}"
                               FontSize="32" FontWeight="Bold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="10" Padding="18" Margin="0,0,12,0"
                    BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.Today]}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"/>
                    <TextBlock Text="{Binding ClicksToday, StringFormat='{}{0:N0}'}"
                               FontSize="32" FontWeight="Bold" Foreground="#AA70FF" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="10" Padding="18" Margin="0,0,12,0"
                    BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.MostFrequent]}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"/>
                    <TextBlock Text="{Binding MostFrequentKey}"
                               FontSize="32" FontWeight="Bold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="10" Padding="18"
                    BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.ErrorRate]}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ErrorRate, StringFormat='{}{0}%'}"
                                   FontSize="32" FontWeight="Bold" Foreground="#FF8080"/>
                        <TextBlock Text=" (Backspace)" Foreground="#303060" FontSize="12"
                                   VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" CornerRadius="10" Padding="16"
                BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.History]}"
                               Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=MutedText}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.Days]}" Command="{Binding SelectHistoryScaleCommand}" CommandParameter="Days" Tag="{Binding IsDaysSelected}" Style="{StaticResource HistoryButton}" Margin="4,0"/>
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.Months]}" Command="{Binding SelectHistoryScaleCommand}" CommandParameter="Months" Tag="{Binding IsMonthsSelected}" Style="{StaticResource HistoryButton}" Margin="4,0"/>
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Overview.Years]}" Command="{Binding SelectHistoryScaleCommand}" CommandParameter="Years" Tag="{Binding IsYearsSelected}" Style="{StaticResource HistoryButton}" Margin="4,0"/>
                        <Button Content="‹" FontSize="18" Command="{Binding ShiftHistoryCommand}" CommandParameter="-1" Style="{StaticResource HistoryButton}" Margin="8,0,4,0" Padding="9,0"/>
                        <TextBlock Text="{Binding HistoryPeriod}" VerticalAlignment="Center" MinWidth="110" TextAlignment="Center"/>
                        <Button Content="›" FontSize="18" Command="{Binding ShiftHistoryCommand}" CommandParameter="1" IsEnabled="{Binding CanGoForward}" Style="{StaticResource HistoryButton}" Margin="4,0" Padding="9,0"/>
                        <TextBlock Text="{Binding HistoryTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AA70FF" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1"
                                    MinHeight="260"
                                    Series="{Binding DailyStatsSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Bottom"
                                    LegendTextPaint="{Binding LegendTextPaint}"
                                    TooltipPosition="Top"
                                    TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                    TooltipTextPaint="{Binding TooltipTextPaint}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

