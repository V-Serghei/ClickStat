<Window x:Class="ClickStat.Presentation.Views.AchievementDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ClickStat.Presentation.Services"
        Title="{Binding Title}" Width="540" Height="455" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="12" Background="#302650" Margin="0,0,16,0">
                <TextBlock Text="{Binding Icon}" FontSize="36" Foreground="#AA70FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Category}" Foreground="#AA70FF" FontSize="12"/>
                <TextBlock Text="{Binding Title}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888AA0"/><Style.Triggers><DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter Property="Foreground" Value="#65D799"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{Binding Source={x:Static services:ThemeService.Instance}, Path=PanelBackground}" BorderBrush="{Binding Source={x:Static services:ThemeService.Instance}, Path=CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Description}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Achievements.HowTo]}" Foreground="#AA70FF" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <TextBlock Text="{Binding Detail}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=SecondaryText}" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Achievements.YourProgress]}" Foreground="#AA70FF" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="8" Foreground="#AA70FF" Background="#111326"/>
                <TextBlock Text="{Binding Counter}" Foreground="{Binding Source={x:Static services:ThemeService.Instance}, Path=PrimaryText}" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding UnlockedDate}" Foreground="#65D799" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="2" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common.Close]}" Click="Close_Click" HorizontalAlignment="Right" Padding="20,8" Background="#7046BB" Foreground="White" BorderBrush="#AA70FF"/>
    </Grid>
</Window>
